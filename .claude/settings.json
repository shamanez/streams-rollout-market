{
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(python examples/*)",
      "Bash(python -c *)",
      "Bash(python -m rollout_market*)",
      "Bash(pip install -e*)",
      "Bash(pip install *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(ls*)",
      "Bash(wc*)",
      "Bash(mkdir*)",
      "Bash(chmod*)",
      "Bash(sha256sum*)",
      "Bash(bash .claude/scripts/*)",
      "Bash(ssh my-vllm-spot-instance*)",
      "Bash(scp *my-vllm-spot-instance*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(curl*|sh)",
      "Bash(wget*|sh)",
      "Bash(aws ec2 create*)",
      "Bash(aws ec2 terminate*)",
      "Bash(aws ec2 modify*)",
      "Bash(aws ec2 run*)",
      "Bash(aws ec2 stop*)",
      "Bash(aws ec2 start*)",
      "Bash(aws s3 rm*)",
      "Bash(aws iam*)",
      "Bash(aws cloudformation*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/firewall-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/aws-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/kill-switch-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/track-evidence.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/commit-on-stop.sh"
          }
        ]
      }
    ]
  }
}
